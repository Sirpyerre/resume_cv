# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===========================================
# FORMSPREE CONFIGURATION (Recommended)
# ===========================================
# 1. Go to https://formspree.io
# 2. Sign up for a free account
# 3. Create a new form
# 4. Copy your Form ID (looks like: xwpejknb)
# 5. Paste it below
VITE_FORMSPREE_FORM_ID=

# Example: VITE_FORMSPREE_FORM_ID=xwpejknb


# ===========================================
# WHATSAPP (requerido para los CTA de contacto)
# ===========================================
# Codigo de pais + numero, sin + ni espacios.
# Se usa en el hero y en el boton flotante. Si se deja vacio, ambos CTA
# hacen fallback a la pagina de contacto.
VITE_WHATSAPP_NUMBER=

# Ejemplo: VITE_WHATSAPP_NUMBER=5212221234567


# ===========================================
# ALTERNATIVE: MAILTRAP (Development Only)
# ===========================================
# If you want to use Mailtrap for development testing:
# 1. Go to https://mailtrap.io
# 2. Sign up for a free account
# 3. Create an inbox
# 4. Get your SMTP credentials
# 5. Uncomment and fill in below

# MAILTRAP_HOST=smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=
# MAILTRAP_PASS=


# ===========================================
# NOTES
# ===========================================
# - After editing this file, rename it to .env
# - Restart your dev server after changes: npm run dev
# - NEVER commit the .env file to git (it's in .gitignore)
# - For production, add these variables to your hosting platform
#   (Netlify: Site settings > Environment variables)
