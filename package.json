{
    "name": "pedro-portfolio",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && react-snap",
        "preview": "vite preview",
        "sitemap": "node ./src/utils/seo-generator.js"
    },
    "reactSnap": {
        "source": "dist",
        "destination": "dist",
        "include": ["/"],
        "headless": true,
        "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"]
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet": "^6.1.0",
        "react-helmet-async": "^1.3.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.9.6"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.14",
        "postcss": "^8.4.24",
        "react-snap": "^1.23.0",
        "tailwindcss": "^3.4.8",
        "vite": "^7.3.2"
    },
    "resolutions": {
        "picomatch": "^2.3.2",
        "brace-expansion": "^2.0.3"
    }
}
