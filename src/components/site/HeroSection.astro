---
import { getDictionary, getSiteLinks } from "../../lib/i18n.js"

const { language = "es" } = Astro.props
const t = getDictionary(language)
const links = getSiteLinks(language)
const whatsappNumber = import.meta.env.VITE_WHATSAPP_NUMBER
const whatsappMessage =
  language === "en"
    ? "Hi! I would like to inquire about your web services."
    : "Hola! Me gustaria consultar sobre sus servicios web."
const whatsappHref = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`
  : links.contact
---

<section id="hero" class="bg-crema min-h-screen flex flex-col justify-center px-4 sm:px-6 pb-12">
  <div class="max-w-6xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <div class="flex flex-col gap-5 lg:gap-6">
        <div>
          <span class="inline-flex items-center gap-2 border border-tinta/20 rounded-full px-4 py-1.5 text-xs font-semibold tracking-widest text-tinta-suave uppercase">
            <span class="w-2 h-2 rounded-full bg-verde flex-shrink-0"></span>
            {t.hero.badge}
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-bold text-tinta leading-tight">
          {t.hero.headlinePart1}<br />
          {t.hero.headlinePart2}{" "}
          <em class="font-lora italic text-verde">{t.hero.headlineAccent}</em><br />
          {t.hero.headlinePart3}
        </h1>

        <p class="text-base sm:text-lg text-tinta-suave leading-relaxed max-w-lg">
          {t.hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
          <a
            href={links.contact}
            class="inline-flex items-center justify-center gap-2 bg-verde text-crema px-6 py-4 rounded-lg font-bold text-base hover:bg-verde/90 transition-all duration-200 shadow-md"
          >
            {t.hero.ctaPrimary} →
          </a>
          <a
            href={links.portfolio}
            class="inline-flex items-center justify-center gap-2 text-tinta-suave font-medium text-base hover:text-verde transition-colors px-2 py-3"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            {[
              { initial: "A", bg: "bg-verde" },
              { initial: "M", bg: "bg-tinta-suave" },
              { initial: "R", bg: "bg-cobre" },
            ].map(({ initial, bg }) => (
              <div
                class={`w-9 h-9 rounded-full border-2 border-crema flex items-center justify-center text-crema text-sm font-bold ${bg}`}
              >
                {initial}
              </div>
            ))}
          </div>
          <div>
            <div class="text-yellow-500 text-sm leading-none mb-1">★★★★★</div>
            <p class="text-sm text-tinta-suave">
              <strong class="text-tinta">{t.hero.socialProofCount}</strong> {t.hero.socialProofText}
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div class="bg-crema-medio rounded-2xl p-5 sm:p-6 border border-crema-oscuro">
          <span class="text-xs font-bold tracking-widest text-tinta-suave uppercase mb-3 block">
            {t.hero.popularLabel}
          </span>
          <h2 class="text-2xl font-bold text-tinta mb-2">{t.hero.popularServiceName}</h2>
          <p class="text-tinta-suave text-sm mb-5 leading-relaxed">{t.hero.popularServiceDesc}</p>

          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-4xl font-bold text-tinta">{t.hero.popularServicePrice}</span>
            <span class="text-tinta-suave text-sm">
              {t.hero.popularServiceCurrency} · {t.hero.popularServiceDelivery}
            </span>
          </div>

          <ul class="space-y-2.5">
            {t.hero.popularServiceFeatures.map((feature) => (
              <li class="flex items-center gap-2.5 text-sm text-tinta-suave">
                <span class="text-verde">✓</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="bg-crema-medio rounded-xl p-4 border border-crema-oscuro">
            <span class="text-xl mb-2 block">⚙️</span>
            <h3 class="font-bold text-tinta text-sm mb-1">{t.hero.webAppName}</h3>
            <p class="text-xs text-tinta-suave leading-relaxed">{t.hero.webAppDesc}</p>
          </div>
          <div class="bg-crema-medio rounded-xl p-4 border border-crema-oscuro">
            <span class="text-xl mb-2 block">🔧</span>
            <h3 class="font-bold text-tinta text-sm mb-1">{t.hero.maintenanceName}</h3>
            <p class="text-xs text-tinta-suave leading-relaxed">{t.hero.maintenanceDesc}</p>
          </div>
        </div>

        <div class="bg-tinta rounded-xl px-5 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <p class="text-crema font-semibold text-sm">{t.hero.whatsappQuestion}</p>
            <p class="text-crema/60 text-xs mt-0.5">{t.hero.whatsappText}</p>
          </div>
          <a
            href={whatsappHref}
            target={whatsappNumber ? "_blank" : undefined}
            rel={whatsappNumber ? "noopener noreferrer" : undefined}
            class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BA5A] text-white px-4 py-2.5 rounded-lg font-bold text-sm transition-colors whitespace-nowrap flex-shrink-0"
          >
            {t.hero.whatsappCta}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
