---
import { getDictionary, getSiteLinks } from "../../lib/i18n.js"
import { getWhatsAppHref } from "../../config/contact.js"

const { language = "es" } = Astro.props
const t = getDictionary(language)
const links = getSiteLinks(language)
const whatsappMessage =
  language === "en"
    ? "Hi! I would like to inquire about your web services."
    : "Hola! Me gustaria consultar sobre sus servicios web."
const whatsappHref = getWhatsAppHref(whatsappMessage) ?? links.contact
---

<section id="hero" class="bg-crema px-4 sm:px-6 pt-10 pb-16 lg:pt-16 lg:pb-20">
  <div class="max-w-6xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <div class="flex flex-col gap-5 lg:gap-6">
        <div>
          <span class="inline-flex items-center gap-2 border border-crema-oscuro rounded-full px-4 py-1.5 font-heading text-xs font-bold tracking-widest text-tinta-suave uppercase">
            <span class="w-2 h-2 rounded-full bg-verde flex-shrink-0"></span>
            {t.hero.badge}
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-bold text-tinta leading-tight">
          {t.hero.headlinePart1}<br />
          <span class="font-heading text-verde">{t.hero.headlinePart2}</span>
        </h1>

        <p class="text-base sm:text-lg text-tinta-suave leading-relaxed max-w-lg">
          {t.hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
          <a
            href={links.contact}
            class="btn-primary"
          >
            {t.hero.ctaPrimary} →
          </a>
          <a
            href={links.portfolio}
            class="btn-outline-primary"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex -space-x-2">
            {[
              { initial: "A", bg: "bg-verde" },
              { initial: "M", bg: "bg-tinta-suave" },
              { initial: "R", bg: "bg-cobre" },
            ].map(({ initial, bg }) => (
              <div
                class={`w-9 h-9 rounded-full border-2 border-crema flex items-center justify-center text-crema text-sm font-bold ${bg}`}
              >
                {initial}
              </div>
            ))}
          </div>
          <div>
            <div class="text-yellow-500 text-sm leading-none mb-1">★★★★★</div>
            <p class="text-sm text-tinta-suave">
              <strong class="text-tinta">{t.hero.socialProofCount}</strong> {t.hero.socialProofText}
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
      <div class="card p-5 sm:p-6">
        <h2 class="text-xl sm:text-2xl font-bold text-tinta mb-4">{t.hero.selectorTitle}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {t.services.packages.map((pkg, index) => (
            <a href={pkg.href} class="group rounded-lg border border-crema-oscuro bg-crema p-4 hover:border-verde transition-colors">
              <span class="text-xl mb-2 block">{["🌐", "💻", "⚙️", "🔧"][index]}</span>
              <span class="block font-bold text-tinta text-sm mb-1">{pkg.name}</span>
              <span class="block text-xs font-semibold text-cobre mb-2">{pkg.price}</span>
              <span class="block text-xs text-tinta-suave leading-relaxed">{pkg.description}</span>
              <span class="block text-verde text-sm font-bold mt-3">{language === "en" ? "Explore service" : "Conoce el servicio"} →</span>
            </a>
          ))}
        </div>
      </div>

        <div class="bg-tinta rounded-lg px-5 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <p class="text-crema font-semibold text-sm">{t.hero.whatsappQuestion}</p>
            <p class="text-crema/60 text-xs mt-0.5">{t.hero.whatsappText}</p>
          </div>
          <a
            href={whatsappHref}
            target={getWhatsAppHref(whatsappMessage) ? "_blank" : undefined}
            rel={getWhatsAppHref(whatsappMessage) ? "noopener noreferrer" : undefined}
            class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BA5A] text-white px-4 py-2.5 rounded-lg font-bold text-sm transition-colors whitespace-nowrap flex-shrink-0"
          >
            {t.hero.whatsappCta}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
