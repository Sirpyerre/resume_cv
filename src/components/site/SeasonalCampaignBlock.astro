---
import { CAMPAIGN } from "../../config/campaign.js"
import { getSiteLinks } from "../../lib/i18n.js"

const { language = "es" } = Astro.props
const copy = CAMPAIGN.copy[language]
const links = getSiteLinks(language)
const soldOut = CAMPAIGN.remainingSlots <= 0
---

{CAMPAIGN.active && (
  <section class="px-4 sm:px-6 pb-12 bg-crema" aria-labelledby="campaign-title">
    <div class="max-w-4xl mx-auto rounded-xl border border-crema-oscuro bg-crema-medio p-6 sm:p-8">
      <p class="font-heading text-xs font-bold tracking-[0.14em] uppercase text-verde mb-3">{copy.badge}</p>
      <h2 id="campaign-title" class="font-heading text-2xl sm:text-3xl font-bold text-tinta">{copy.title}</h2>
      <p class="text-tinta-suave leading-relaxed mt-3">{copy.intro}</p>

      <div class="mt-6 rounded-lg border border-crema-oscuro bg-crema p-4 sm:p-5">
        <h3 class="font-heading font-bold text-tinta">{copy.diagnosticTitle}</h3>
        <p class="text-sm text-tinta-suave leading-relaxed mt-2">{copy.diagnosticBody}</p>
      </div>

      {!soldOut && (
        <ul class="mt-4 grid sm:grid-cols-2 gap-4">
          {copy.options.map((option) => (
            <li class="rounded-lg border border-crema-oscuro bg-crema p-4 sm:p-5">
              <h3 class="font-heading font-bold text-tinta">{option.title}</h3>
              <p class="text-sm text-tinta-suave leading-relaxed mt-2">{option.body}</p>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-5 text-sm font-semibold text-cobre">
        {soldOut ? copy.soldOut : copy.slotsLabel(CAMPAIGN.remainingSlots, CAMPAIGN.totalSlots)}
      </p>

      {!soldOut && (
        <>
          <h3 class="font-heading font-bold text-tinta mt-6">{copy.conditionsTitle}</h3>
          <ul class="mt-2 space-y-1">
            {copy.conditions(CAMPAIGN.closingDate[language]).map((item) => (
              <li class="flex gap-2 text-sm text-tinta-suave leading-relaxed"><span aria-hidden="true" class="text-verde">✓</span><span>{item}</span></li>
            ))}
          </ul>
        </>
      )}

      <a href={links.contact} aria-label={copy.ctaAriaLabel} class="btn-primary inline-block mt-6 px-5 text-sm">{copy.cta} →</a>
    </div>
  </section>
)}
