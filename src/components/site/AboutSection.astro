---
import { getDictionary } from "../../lib/i18n.js"

const { language = "es" } = Astro.props
const t = getDictionary(language)
const a = t.about
const icons = {
  shield: "🛡️",
  code: "💻",
  handshake: "🤝",
}
const photoUrl =
  "https://res.cloudinary.com/dtbpucouh/image/upload/v1778863953/portada-pedro-rojas-lat_resize_yruq8s.jpg"
---

<section id="about" class="py-16 sm:py-20 px-4 sm:px-6 bg-crema-medio">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-10 sm:mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-verde flex items-center justify-center gap-3">
        <span>&lt;/&gt;</span>
        {a.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center mb-12 sm:mb-16">
      <div class="flex justify-center lg:justify-end">
        <div class="relative w-64 sm:w-72 lg:w-80">
          <div class="absolute -bottom-3 -right-3 w-full h-full rounded-2xl bg-verde/15 border border-verde/20"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-xl border-2 border-crema-oscuro">
            <img
              src={photoUrl}
              alt="Pedro Rojas Reyes"
              class="w-full h-auto object-cover object-top"
              loading="lazy"
            />
          </div>
          <div class="absolute -top-4 -left-4 bg-verde text-crema text-xs font-bold px-3 py-2 rounded-xl shadow-lg leading-tight text-center">
            {a.experience}
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <div>
          <h3 class="text-2xl sm:text-3xl font-bold text-tinta mb-1">Pedro Rojas Reyes</h3>
          <div class="flex items-center gap-2 text-tinta-suave text-sm font-medium">
            <span class="w-2 h-2 rounded-full bg-verde flex-shrink-0"></span>
            {a.role}
          </div>
          <div class="flex items-center gap-1.5 text-tinta-suave/70 text-sm mt-1">📍 {a.location}</div>
        </div>

        <div class="w-12 h-0.5 bg-verde/30 rounded-full"></div>

        <div class="space-y-4">
          <p class="text-base sm:text-lg text-tinta leading-relaxed">{a.paragraph1}</p>
          <p class="text-base sm:text-lg text-tinta leading-relaxed">{a.paragraph2}</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.whyMe.reasons.map((reason) => (
        <div class="bg-crema rounded-xl p-6 border border-crema-oscuro hover:border-verde transition-colors duration-300">
          <div class="flex justify-center mb-4">
            <div class="bg-verde/10 p-4 rounded-full text-3xl">{icons[reason.icon]}</div>
          </div>
          <h3 class="text-lg font-bold text-tinta mb-3 text-center">{reason.title}</h3>
          <p class="text-tinta-suave text-sm text-center leading-relaxed">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
