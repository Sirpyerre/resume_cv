---
import { getDictionary, getSiteLinks } from "../../lib/i18n.js"
import { getWhatsAppHref } from "../../config/contact.js"

const { language = "es", showCta = true } = Astro.props
const t = getDictionary(language)
const links = getSiteLinks(language)
---

<section id="services" class="section bg-crema-medio">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-tinta mb-4 text-center">
      {t.services.title}
    </h2>
    <p class="text-tinta-suave text-center mb-12 max-w-3xl mx-auto">
      {t.services.subtitle}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
      {t.services.packages.map((pkg) => (
        <div class={`bg-crema rounded-lg p-6 border transition-all duration-300 flex flex-col ${pkg.featured ? "border-2 border-verde shadow-xl lg:scale-[1.03]" : "border-crema-oscuro hover:border-verde"}`}>
          {pkg.badge && <span class="self-start bg-verde text-white text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">{pkg.badge}</span>}
          <div class="mb-4">
            <h3 class="text-2xl font-bold text-tinta mb-2">{pkg.name}</h3>
            <p class="text-cobre text-xl font-semibold">{pkg.price}</p>
            {pkg.priceAlt && <p class="text-cobre text-base font-semibold">{pkg.priceAlt}</p>}
            <p class="text-xs font-bold uppercase tracking-wide text-tinta-suave mb-4 mt-1">⏱ {pkg.time}</p>
            <p class="text-tinta-suave mb-6">{pkg.description}</p>
          </div>

          <div class="mb-6 flex-grow">
            <h4 class="text-tinta font-semibold mb-3">
              {pkg.featuresLabel ?? (language === "en" ? "Includes:" : "Incluye:")}
            </h4>
            <ul class="space-y-2">
              {pkg.features.map((feature) => (
                <li class="flex items-start text-tinta-suave">
                  <span class="text-verde mt-0.5 mr-2 flex-shrink-0">✓</span>
                  <span class="text-sm">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto pt-4 border-t border-crema-oscuro">
            <p class="text-xs text-tinta-suave/70 italic">{pkg.ideal}</p>
            <a
              href={getWhatsAppHref(pkg.ctaMessage) ?? links.contact}
              target={getWhatsAppHref(pkg.ctaMessage) ? "_blank" : undefined}
              rel={getWhatsAppHref(pkg.ctaMessage) ? "noopener noreferrer" : undefined}
              data-whatsapp-location={`servicio-${pkg.href}`}
              class="btn-primary w-full text-center mt-4"
            >
              {pkg.cta} →
            </a>
            <a
              href={pkg.href}
              class="inline-flex items-center gap-2 mt-3 font-heading text-sm font-bold text-verde hover:text-cobre transition-colors"
            >
              {language === "en" ? "See details" : "Ver detalles"} →
            </a>
            {pkg.extraHref && (
              <a href={pkg.extraHref} class="block mt-2 text-xs text-tinta-suave underline hover:text-verde">{pkg.extraLabel}</a>
            )}
          </div>
        </div>
      ))}
    </div>

    {showCta && (
      <div class="text-center mt-12">
        <a
          href={links.contact}
          class="btn-primary"
        >
          {language === "en" ? "Book my free consultation" : "Agenda mi consulta gratis"}
        </a>
      </div>
    )}
  </div>
</section>
