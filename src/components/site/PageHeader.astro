---
const { eyebrow, title, description } = Astro.props
---

<section class="px-4 sm:px-6 py-12 sm:py-16 bg-crema">
  <div class="max-w-4xl mx-auto text-center">
    {eyebrow && (
      <span class="inline-flex items-center gap-2 text-[11px] font-bold tracking-widest text-verde border border-verde/40 rounded-full px-4 py-1.5 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-verde" />
        {eyebrow}
      </span>
    )}
    <h1 class="font-lora text-4xl sm:text-5xl font-bold text-tinta leading-tight mb-4">
      {title}
    </h1>
    {description && (
      <p class="text-base sm:text-lg text-tinta-suave leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>
    )}
  </div>
</section>
