---
import BaseLayout from "../../layouts/BaseLayout.astro"
import AboutSection from "../site/AboutSection.astro"
import HeroSection from "../site/HeroSection.astro"
import ServicesSection from "../site/ServicesSection.astro"
import ContactForm from "../islands/ContactForm.jsx"
import FAQAccordion from "../islands/FAQAccordion.jsx"
import PortfolioCarousel from "../islands/PortfolioCarousel.jsx"

const { language = "es" } = Astro.props
const copy =
  language === "en"
    ? {
        title: "Freelance Web Developer in Puebla | Pedro Rojas Reyes",
        description:
          "Pedro Rojas Reyes, freelance web developer in Puebla. Websites, custom software, and internal systems for local businesses and clinics. Free quote.",
      }
    : {
        title: "Desarrollador Web Freelance en Puebla | Pedro Rojas Reyes",
        description:
          "Pedro Rojas Reyes, desarrollador web freelance en Puebla. Páginas web, software a medida y sistemas para negocios y consultorios. Cotiza gratis.",
      }
---

<BaseLayout
  language={language}
  title={copy.title}
  description={copy.description}
  basePath="/"
>
  <HeroSection language={language} />
  <AboutSection language={language} />
  <ServicesSection language={language} />
  <PortfolioCarousel client:visible language={language} />
  <FAQAccordion client:idle language={language} />
  <ContactForm client:visible language={language} />
</BaseLayout>
