---
import BaseLayout from "../../layouts/BaseLayout.astro"
import AboutSection from "../site/AboutSection.astro"
import HeroSection from "../site/HeroSection.astro"
import ServicesSection from "../site/ServicesSection.astro"
import ContactForm from "../islands/ContactForm.jsx"
import FAQAccordion from "../islands/FAQAccordion.jsx"
import PortfolioCarousel from "../islands/PortfolioCarousel.jsx"

const { language = "es" } = Astro.props
const copy =
  language === "en"
    ? {
        title: "Web Development & Custom Software in Puebla | Pedro Rojas",
        description:
          "Websites, custom apps, and internal systems for Puebla businesses. Replace manual tasks with digital tools designed around your process.",
      }
    : {
        title: "Desarrollo web y software a medida en Puebla | Pedro Rojas",
        description:
          "Sitios web, aplicaciones y sistemas internos para empresas en Puebla. Digitaliza procesos manuales con herramientas diseñadas para tu operación.",
      }
---

<BaseLayout
  language={language}
  title={copy.title}
  description={copy.description}
  basePath="/"
>
  <HeroSection language={language} />
  <AboutSection language={language} />
  <ServicesSection language={language} />
  <PortfolioCarousel client:visible language={language} />
  <FAQAccordion client:idle language={language} />
  <ContactForm client:visible language={language} />
</BaseLayout>
