---
import BaseLayout from "../../layouts/BaseLayout.astro"
import ServicesSection from "../site/ServicesSection.astro"
import PageHeader from "../site/PageHeader.astro"
import JsonLd from "../seo/JsonLd.astro"
import { buildServiceCatalog } from "../../lib/schema.js"

const { language = "es" } = Astro.props
const copy =
  language === "en"
    ? {
        title: "Websites & Business Software in Puebla | Pedro Rojas",
        heading: "Digital solutions built around your business",
        description:
          "From a professional website to custom software and internal systems that help your team manage work in one place.",
      }
    : {
        title: "Desarrollo web y software a medida | Puebla",
        heading: "Soluciones digitales para la operación de tu empresa",
        description:
          "Desde una página web profesional hasta software a medida y sistemas internos para organizar información y reducir tareas manuales.",
      }

const serviceSchema = buildServiceCatalog(language)
---

<BaseLayout
  language={language}
  title={copy.title}
  description={copy.description}
  basePath="/services"
>
  <JsonLd slot="head" schema={serviceSchema} />
  <PageHeader eyebrow="SERVICES" title={copy.heading} description={copy.description} />
  <ServicesSection language={language} showCta={true} />
</BaseLayout>
