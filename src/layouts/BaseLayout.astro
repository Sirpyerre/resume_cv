---
import SiteNavbar from "../components/islands/SiteNavbar.jsx"
import ConsentBanner from "../components/islands/ConsentBanner.jsx"
import WhatsAppButton from "../components/islands/WhatsAppButton.jsx"
import SiteFooter from "../components/site/SiteFooter.astro"
import JsonLd from "../components/seo/JsonLd.astro"
import { SITE_CONFIG } from "../config/site.js"
import { buildLocalBusiness, buildPerson, buildWebSite } from "../lib/schema.js"
import {
  getAlternateLocalePath,
  getLocalizedPath,
  getSiteLinks,
  getUiCopy,
} from "../lib/i18n.js"
import "../index.css"

const {
  language = "es",
  title,
  description,
  basePath = "/",
  image = "/hero-section-resize1.png",
  noIndex = false,
  ogType = "website",
  publishedTime,
  // Rutas sin traduccion propia (p. ej. /en/blog/<slug>) apuntan su canonical a
  // la version ES y no emiten hreflang, para no declarar una alternancia falsa.
  canonicalPath,
} = Astro.props

const localizedPath = getLocalizedPath(language, basePath)
const alternateLocalePath = getAlternateLocalePath(language, basePath)
const canonicalUrl = `${SITE_CONFIG.SITE_URL}${canonicalPath ?? localizedPath}`
const esUrl = `${SITE_CONFIG.SITE_URL}${getLocalizedPath("es", basePath)}`
const enUrl = `${SITE_CONFIG.SITE_URL}${getLocalizedPath("en", basePath)}`
const imageUrl = image.startsWith("http") ? image : `${SITE_CONFIG.SITE_URL}${image}`
const links = getSiteLinks(language)
const ui = getUiCopy(language)
const emitHreflang = !canonicalPath
const baseSchemas = [
  buildLocalBusiness(language),
  buildWebSite(),
  buildPerson(language),
]
---

<!doctype html>
<html lang={language === "es" ? "es-MX" : "en-US"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />
    <meta name="theme-color" content="#2D6A4F" />
    <link rel="canonical" href={canonicalUrl} />
    {
      emitHreflang && (
        <>
          <link rel="alternate" hreflang="es-MX" href={esUrl} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="x-default" href={esUrl} />
        </>
      )
    }

    <meta name="geo.region" content="MX-PUE" />
    <meta name="geo.placename" content="Puebla, México" />
    <meta name="geo.position" content="19.0414;-98.2063" />
    <meta name="ICBM" content="19.0414, -98.2063" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pedro Rojas - Desarrollo Web Puebla" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={language === "es" ? "es_MX" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={language === "es" ? "en_US" : "es_MX"}
    />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <JsonLd schema={baseSchemas} />

    <slot name="head" />
  </head>
  <body id="top" class="min-h-screen bg-crema text-tinta overflow-x-hidden">
    <SiteNavbar
      client:idle
      language={language}
      basePath={basePath}
      links={links}
      ui={ui}
      alternateLocalePath={alternateLocalePath}
    />
    <main class="overflow-x-hidden pt-20">
      <slot />
    </main>
    <SiteFooter language={language} />
    <ConsentBanner
      client:load
      language={language}
      cookiePolicyPath={links.cookies}
    />
    <WhatsAppButton client:idle language={language} />
  </body>
</html>
