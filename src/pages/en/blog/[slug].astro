---
import { getCollection } from "astro:content"
import BlogPostPage from "../../../components/pages/BlogPostPage.astro"

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) =>
    post.data.language === "en" || (!post.data.translationKey && post.data.language !== "en"),
  )

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
---

<BlogPostPage entry={post} language="en" />
